# ---------------------------------------------------------------------------
# Financial Twin - configuration. Everything here is OPTIONAL.
# The demo runs fully without this file and without any API key.
# ---------------------------------------------------------------------------

# Tier 3 (narrative wording only). If unset, deterministic templates are used
# and the UI shows the "template" badge instead of the "Claude" badge.
# ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model writes the narratives.
TWIN_LLM_MODEL=claude-opus-5-5

# --- Synthetic data -------------------------------------------------------
TWIN_SEED=42
TWIN_CUSTOMERS=1000
TWIN_MONTHS=12

# --- Benchmark (runs once at startup, off the request path) ---------------
TWIN_BENCHMARK_CUSTOMERS=100000
TWIN_BENCHMARK_EVENTS_PER_CUSTOMER=12
TWIN_TARGET_POPULATION=2300000
TWIN_BENCHMARK_ON_STARTUP=1

# --- Cost model (README section 16). Edit these, never hardcode. ----------
# USD per million tokens. Defaults = Claude Opus 5.5 list price.
TWIN_LLM_PRICE_INPUT_PER_MTOK=4.00
TWIN_LLM_PRICE_OUTPUT_PER_MTOK=20.00
TWIN_LLM_TOKENS_IN=900
TWIN_LLM_TOKENS_OUT=160
TWIN_ASSUMPTION_DAILY_APP_OPEN_RATE=0.05
TWIN_ASSUMPTION_MONTHLY_TWIN_CHANGE_RATE=0.10
